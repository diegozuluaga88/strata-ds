{
  "name": "@diegozuluaga88/strata-design-system",
  "version": "0.1.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "description": "Strata Design System - Catalyst-based component library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/tokens": "./dist/styles/tokens/variables.css",
    "./styles/tokens-dark": "./dist/styles/tokens/variables-dark.css",
    "./styles/theme": "./dist/styles/tokens/theme-v4.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "governance",
    "README.md",
    "COMPONENT_GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/scan-security.mjs && vite build",
    "server": "npx tsx src/mcp-server/mcp-http.ts",
    "server:dev": "npx tsx --watch src/mcp-server/mcp-http.ts",
    "build:guide": "node governance/build-guide.mjs",
    "lint:tsx-diff": "npx tsx scripts/lint-tsx-diff.mjs",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "tokens:figma": "node scripts/figma-tokens.mjs",
    "tokens:figma:check": "node scripts/figma-tokens.mjs --check",
    "build:tokens": "node scripts/validate-tokens.mjs && node build-tokens.mjs",
    "build:lib": "npm run build:tokens && vite build --config vite.config.lib.ts",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:manifest": "node sync/generate-manifest.mjs",
    "sync:check": "node sync/sync-check.mjs",
    "sync:check:json": "node sync/sync-check.mjs --json",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:tokens:fix": "node scripts/audit-tokens.mjs --fix",
    "install-hooks": "node scripts/install-hooks.mjs",
    "analyze:refinements": "node scripts/analyze-refinements.mjs",
    "analyze:refinements:update": "node scripts/analyze-refinements.mjs --update",
    "scan:security": "node scripts/scan-security.mjs",
    "tokens:figma:audit": "node scripts/figma-tokens.mjs --audit-snippet",
    "icons:figma": "node scripts/figma-icons.mjs",
    "icons:figma:audit": "node scripts/figma-icons.mjs --audit-snippet",
    "icons:figma:seed": "node scripts/figma-icons.mjs --seed-script"
  },
  "keywords": [
    "design-system",
    "react",
    "catalyst",
    "tailwind",
    "tokens"
  ],
  "author": "Strata Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.29.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tar": "^7.5.16",
    "tsx": "^4.21.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "marked": "^18.0.5",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "4.1.12",
    "typescript": "^5.0.0",
    "vite": "6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.16"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegozuluaga88/strata-ds.git"
  }
}
